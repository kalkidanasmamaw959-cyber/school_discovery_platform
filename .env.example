# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# Required in production; a random value is generated at startup if omitted.
SECRET_KEY=replace-with-a-long-random-value

# Optional database override. Defaults to instance/educonnect.db.
# Relative paths are resolved from the project folder, not the current shell.
# DATABASE_PATH=instance/educonnect.db
# DATABASE_URL=sqlite:///C:/absolute/path/to/educonnect.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001,http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501,http://127.0.0.1:5502,http://localhost:5502,http://127.0.0.1:5503,http://localhost:5503,http://127.0.0.1:5504,http://localhost:5504,http://127.0.0.1:5505,http://localhost:5505,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# Optional: used only by "python -m backend.create_admin".
# Prefer the interactive password prompt instead of storing this value.
# ADMIN_PASSWORD=

# Optional external AI summary for recommendations. Disabled by default.
# The weighted recommendation algorithm works without any API key.
EDUCONNECT_ENABLE_AI=0
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
